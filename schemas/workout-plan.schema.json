{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workout-plan.schema.json",
  "title": "WorkoutPlan",
  "description": "Набор шаблонов тренировок для импорта в приложение",
  "type": "object",
  "required": ["version", "plan_name", "created_at", "templates"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "plan_name": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "author": { "type": "string" },
    "notes": { "type": "string" },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Template" }
    }
  },
  "$defs": {
    "Template": {
      "type": "object",
      "required": ["id", "name", "groups"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "notes": { "type": "string" },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/ExerciseGroup" }
        }
      }
    },
    "ExerciseGroup": {
      "type": "object",
      "required": ["name", "exercises"],
      "properties": {
        "name": { "type": "string" },
        "exercises": {
          "type": "array",
          "items": { "$ref": "#/$defs/Exercise" }
        }
      }
    },
    "Exercise": {
      "type": "object",
      "required": ["id", "name", "body_part", "sets"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "body_part": {
          "type": "string",
          "enum": ["chest", "back", "shoulders", "legs", "arms", "core", "full_body"]
        },
        "equipment": {
          "type": "string",
          "enum": ["machine", "barbell", "dumbbell", "cable", "bodyweight", "plate_loaded", "smith_machine", "other"]
        },
        "sets": {
          "type": "array",
          "items": { "$ref": "#/$defs/PrescribedSet" }
        },
        "rest_seconds": { "type": "integer", "minimum": 0 },
        "technique": {
          "type": "string",
          "enum": ["straight", "drop_set", "rest_pause", "myo_reps", "superset"],
          "default": "straight"
        },
        "superset_with": { "type": "string" },
        "tempo": { "type": "string", "pattern": "^[0-9X]{1,2}-[0-9X]{1,2}-[0-9X]{1,2}-[0-9X]{1,2}$" },
        "notes": { "type": "string" },
        "stretch_focus": { "type": "boolean", "default": false }
      }
    },
    "PrescribedSet": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["warmup", "working", "drop", "backoff"],
          "default": "working"
        },
        "reps": { "type": "integer", "description": "Exact number of prescribed repetitions" },
        "rir": { "type": "integer", "minimum": 0, "maximum": 5 },
        "weight_percent_drop": { "type": "number" }
      }
    }
  }
}
